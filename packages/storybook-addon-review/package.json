{
  "name": "@pairprog/storybook-addon-review",
  "version": "1.0.1",
  "description": "Storybook addon: review stories, comment on an element or a region, and send the comments to your coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "pairprog.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pAIrprogio/storybook-review.git",
    "directory": "packages/storybook-addon-review"
  },
  "keywords": [
    "storybook-addons",
    "review",
    "annotation",
    "ai",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "storybook-review": "dist/cli.js"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.8",
    "zod": "4.6.7"
  }
}
